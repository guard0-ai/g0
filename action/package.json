{
  "name": "@guard0/g0-action",
  "version": "1.0.0",
  "description": "g0 GitHub Action — runs a scan, evaluates the gate, posts a sticky PR comment, uploads SARIF, and writes a job summary",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --define:import.meta.url=__g0ImportMetaUrl --banner:js=\"const __g0ImportMetaUrl=require('url').pathToFileURL(__filename).href;process.stderr.write('g0-action: entry reached\\n');\" --external:tree-sitter --external:tree-sitter-python --external:tree-sitter-typescript --external:tree-sitter-javascript --external:tree-sitter-java --external:tree-sitter-go",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
